# 复制本文件为 .env，填入你自己的值。.env 已被 .gitignore 忽略，不会入库。

# ---- LLM（Anthropic 兼容接口，智谱 GLM / DeepSeek 等均可）----
# 走 OpenAI/Anthropic 兼容协议的模型服务都行，这里以 GLM 为例
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_MODEL=GLM-5.3-Flash

# 可选：如果你用 CC Switch 管理密钥，可改为填 CC Switch 数据库路径，
# 程序会优先读环境变量、没有时再从该库读取。
# CC_SWITCH_DB=C:\Users\<你>\.cc-switch\cc-switch.db

# ---- QQ（OneBot 11 / NapCat）----
OWNER_QQ=你的QQ号
NAPCAT_WS=ws://127.0.0.1:3001

# ---- 微信（ilink 对话开放平台）----
WECHAT_TOKEN=你的ilink_bot_token
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
